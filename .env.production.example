# Copy to .env.production on the production server and fill in every blank secret.
POSTGRES_VERSION=17-alpine
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
PORTFOLIO_SERVICE_PORT=8082
PROFILE_SERVICE_PORT=8083
ADMIN_SERVICE_PORT=8084
DISCOVERY_PORT=8761
IDENTITY_DB_PORT=15432
PORTFOLIO_DB_PORT=15433
PROFILE_DB_PORT=15434
ADMIN_DB_PORT=15435

IDENTITY_DB_USERNAME=identity_user
IDENTITY_DB_PASSWORD=
PORTFOLIO_DB_USERNAME=portfolio_user
PORTFOLIO_DB_PASSWORD=
PROFILE_DB_USERNAME=profile_user
PROFILE_DB_PASSWORD=
ADMIN_DB_USERNAME=admin_user
ADMIN_DB_PASSWORD=

# Generate a unique Base64-encoded secret for production.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
